{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/dev/ark-skills/hooks/config-protection.js\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/dev/ark-skills/hooks/no-em-dash.js\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/dev/ark-skills/hooks/block-no-verify.js\"" }
        ]
      }
    ]
  }
}
